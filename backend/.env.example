# Copy to backend/.env (git-ignored) and fill in values from YOUR OWN Databricks workspace.
# Never commit backend/.env. Never put these values in frontend code.

# --- Application ---
SMARTSTOCK_ENVIRONMENT=local
SMARTSTOCK_LOG_LEVEL=INFO
# JSON list of origins allowed to call the API from a browser.
SMARTSTOCK_CORS_ORIGINS=["http://localhost:3000"]

# --- Read-only data API ---
# csv (default): the generated synthetic files. databricks: UNVERIFIED; only use after the
# connection check and table load have been run and approved against your own workspace.
SMARTSTOCK_DATA_SOURCE=csv
# Folder with suppliers.csv, products.csv, sales.csv, inventory.csv, purchase_orders.csv.
# Defaults to backend/data/synthetic.
# SMARTSTOCK_DATA_DIR=

# --- Databricks SQL Warehouse ---
# SQL Warehouses > (your warehouse) > Connection details
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Personal access token: User settings > Developer > Access tokens. Keep it secret.
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=smartstock_retail

# Bounded network behaviour (defaults shown; the connector's own defaults are 900 s).
# DATABRICKS_SOCKET_TIMEOUT_SECONDS=30        # per HTTP request, 5-300
# DATABRICKS_RETRY_MAX_ATTEMPTS=3             # per request, 1-10
# DATABRICKS_RETRY_MAX_DURATION_SECONDS=60    # total retry budget per request, 5-600
# DATABRICKS_STATEMENT_TIMEOUT_SECONDS=60     # server-side, per SQL statement, 10-3600

# Databricks data source only: cache refresh interval and the longest a request waits for the
# first load before getting HTTP 503 (keep below the frontend's 15 s timeout).
# SMARTSTOCK_DATA_REFRESH_SECONDS=300
# SMARTSTOCK_DATA_WAIT_SECONDS=10
